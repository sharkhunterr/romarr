# Git-root .gitignore — the romarr project carries its own .gitignore
# inside romarr/. This one covers the release-pipeline tooling that
# lives at the git root.

# Node — release tooling (standard-version + scripts/*.js)
node_modules/
npm-debug.log*

# Rendered graphic assets — SVG sources are tracked, PNG renders are
# build artifacts regenerated by `npm run assets`.
assets/render/

# OS / editor noise
.DS_Store
*.swp

# Pytest — coverage state file written when a test run touches the
# repo root (e.g. `pytest` from the git-root instead of romarr/).
.coverage
.coverage.*

# Claude Code — session-local temp files
.claude/settings.local.json.tmp.*

# Fichiers scratch d'outillage local (bases de données créées par
# des scripts de test des repos voisins qui écrivent au cwd racine)
smartunarr.db*
smarttunarr.db*

# Claude Code — état local (task_id, lock du scheduler)
.claude/scheduled_tasks.lock

# Bundles /api/v3/backup/export — peuvent contenir des secrets
romarr-backup-*.json
