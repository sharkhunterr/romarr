{
  "name": "@romarr/web",
  "private": true,
  "version": "0.14.0-alpha.1",
  "type": "module",
  "description": "Romarr's React 18 + TypeScript PWA frontend (spec 014).",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint src",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "codegen": "openapi-typescript ./openapi.json -o ./src/types/api/schema.ts"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.62.7",
    "i18next": "^23.16.8",
    "i18next-browser-languagedetector": "^8.2.1",
    "i18next-http-backend": "^2.7.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^15.7.4",
    "react-router-dom": "^6.28.0",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "openapi-typescript": "^7.4.4",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vite-plugin-pwa": "^0.21.2",
    "workbox-window": "^7.4.0"
  },
  "packageManager": "pnpm@10.24.0"
}
